    <string name="tutorial_welcome_title">Welcome to Beep!</string>
    <string name="tutorial_welcome_desc">To transcribe:\n1. Long-press a WhatsApp audio message.\n2. Tap \'Share\' and select \'Beep\'.\n\n💡 Tap outside anytime to skip. You can restart the tutorial anytime from the main menu (\'Start Tutorial\').</string>
    <string name="tutorial_mode_title">Offline / Online Mode</string>
    <string name="tutorial_mode_desc">Swipe right for Online (Gemini) or left for Offline (Whisper) on the menu bar, or switch in the menu.</string>
    <string name="tutorial_model_title">Model Selection</string>
    <string name="tutorial_model_desc">Select or download offline models from the menu.\n\nNote: The Tiny model is of the lowest quality and should NOT be used for real conversions (testing only). Higher-quality models provide much better accuracy, but take much more time to convert audio to text.</string>
    <string name="tutorial_language_title">Audio Language Selection</string>
    <string name="tutorial_language_desc">If auto-detection misidentifies the language, tap \'Select Audio Language\' in the menu to set your preferred transcription language (e.g., English, Hebrew, Spanish).</string>
    <string name="tutorial_history_title">History</string>
    <string name="tutorial_history_desc">View your past transcriptions or a sample message.</string>
    <string name="tutorial_tasks_title">Copying &amp; Managing Tasks</string>
    <string name="tutorial_tasks_desc">Long-press the text of a transcription to copy it to your clipboard.\n\nLong-press anywhere else on the card to remove it.</string>
    <string name="tutorial_options_title">More Options</string>
    <string name="tutorial_options_desc">Access menu options like \'Select Audio Language\', \'Record Audio\', \'Select / Download Model\', \'Configure Gemini\', \'View Logs\', and \'About\'.\n\nYou can reopen this tutorial anytime by selecting \'Start Tutorial\' from the main menu.</string>
